# This .env file is used for Docker Compose and deployment purposes.
# To run the applications manually, please refer to the README.md files in the respective directories.

# Hosts PORTS
DB_HOST_PORT=5432
API_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Backend + DB

POSTGRES_DB=teamlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection string mentioned in the Backend/src/TeamLink.Api/.env
# Host - Docker Compose service ("db") name or other hostname
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=teamlink;Username=postgres;Password=postgres

